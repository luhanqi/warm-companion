# 后端
NUANBAN_HOST=127.0.0.1
NUANBAN_PORT=8002
NUANBAN_RELOAD=0
NUANBAN_AUTO_START_MODELS=0
COOKIE_SECURE=0
NUANBAN_SEED_DEMO_ACCOUNTS=0

# 本地自训练对话模型（OpenAI 兼容）
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=local
LLM_MODEL=nuanban

# 或使用 DeepSeek（填写自己的密钥；不用时留空）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 本地 RAG
EMBEDDING_BASE_URL=http://127.0.0.1:8004/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_BASE_URL=http://127.0.0.1:8004/v1
RERANK_API_KEY=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 语音识别
SPEECH_BASE_URL=http://127.0.0.1:8003
SPEECH_API_KEY=
SPEECH_MODEL=SenseVoiceSmall
ACOUSTIC_BASE_URL=http://127.0.0.1:8003
ACOUSTIC_API_KEY=
ACOUSTIC_MODEL=openSMILE-eGeMAPSv02

# 老照片理解
VISION_BASE_URL=http://127.0.0.1:8005/v1
VISION_API_KEY=local
VISION_MODEL=Qwen/Qwen2-VL-2B-Instruct

# CosyVoice（运行 model-services/start-cosyvoice.ps1 后启用）
COSYVOICE_BASE_URL=http://127.0.0.1:50000
COSYVOICE_API_KEY=
COSYVOICE_MODEL=Fun-CosyVoice3-0.5B-2512

# 记忆视频（自建 Wan 包装服务或云服务，二选一）
VIDEO_SERVICE_URL=
VIDEO_API_KEY=
VIDEO_PROVIDER=self-hosted
VIDEO_MODEL=Wan2.2-TI2V-5B

# 绘画：pollinations 无密钥；siliconflow 需填写自己的密钥
PAINT_PROVIDER=pollinations
PAINT_API_KEY=
SILICONFLOW_API_KEY=
PAINT_MODEL=Tongyi-MAI/Z-Image-Turbo
PAINT_PYTHON=runtime\model-env\python.exe

# 可选研究型认知模型
COGNITION_MODEL_URL=
COGNITION_MODEL_API_KEY=
COGNITION_MODEL_NAME=custom-validated-classifier
